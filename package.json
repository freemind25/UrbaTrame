{
  "name": "freemap",
  "version": "0.1.0",
  "private": true,
  "description": "Freemap : 35 diagrammes d'analyse de site rendus en SVG depuis OpenStreetMap, NASA POWER et les tuiles d'altitude Terrarium, plus des exports CAO (plan DXF, coupe, modèle OBJ/STL). Moteur de plan partagé navigateur/serveur, licences signées Ed25519, aucune dépendance.",
  "keywords": [
    "urbanisme",
    "analyse-de-site",
    "openstreetmap",
    "overpass",
    "svg",
    "posters",
    "architecture",
    "sig",
    "genie-civil",
    "cartographie",
    "dxf",
    "obj",
    "stl",
    "dao",
    "cao",
    "autocad"
  ],
  "license": "MIT",
  "author": "Freemap contributors",
  "type": "module",
  "main": "server/index.mjs",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node tools/run-tests.mjs",
    "test:net": "FM_NET=1 node tools/run-tests.mjs",
    "lint": "node tools/check-syntax.mjs",
    "svg": "node tools/render-svg.mjs",
    "capture": "node tools/capture-sample.mjs",
    "personnaliser": "node tools/personaliser.mjs",
    "genere-cle": "node tools/genere-cle.mjs",
    "dev:vercel": "vercel dev",
    "exporter": "node tools/exporter.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freemind25/freemap.git"
  },
  "bugs": {
    "url": "https://github.com/freemind25/freemap/issues"
  },
  "homepage": "https://github.com/freemind25/freemap#readme",
  "dependencies": {},
  "devDependencies": {}
}
