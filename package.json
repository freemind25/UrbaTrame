{
  "name": "freemap",
  "version": "0.1.0",
  "private": true,
  "description": "UrbaTrame : analyses de site, couche d’occupation OpenBuildingMap et atelier Altiplan intégré, imports SIG locaux GeoPackage/GeoTIFF/GeoJSON/Shapefile, exports DXF/SVG/PNG, maquettes OBJ/STL, OpenStreetMap et NASA POWER.",
  "keywords": [
    "urbanisme",
    "analyse-de-site",
    "openstreetmap",
    "openbuildingmap",
    "overpass",
    "svg",
    "posters",
    "architecture",
    "sig",
    "genie-civil",
    "cartographie",
    "dxf",
    "obj",
    "stl",
    "dao",
    "cao",
    "autocad"
  ],
  "license": "MIT",
  "author": "Freemap contributors",
  "type": "module",
  "main": "server/index.mjs",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node tools/run-tests.mjs",
    "test:net": "FM_NET=1 node tools/run-tests.mjs",
    "lint": "node tools/check-syntax.mjs",
    "svg": "node tools/render-svg.mjs",
    "capture": "node tools/capture-sample.mjs",
    "personnaliser": "node tools/personaliser.mjs",
    "genere-cle": "node tools/genere-cle.mjs",
    "dev:vercel": "vercel dev",
    "exporter": "node tools/exporter.mjs",
    "atelier:exporter": "node tools/atelier/exporter.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freemind25/UrbaTrame.git"
  },
  "bugs": {
    "url": "https://github.com/freemind25/UrbaTrame/issues"
  },
  "homepage": "https://github.com/freemind25/UrbaTrame#readme",
  "devDependencies": {
    "geotiff": "3.0.5",
    "sql.js": "1.15.0"
  }
}
