{
  "name": "maptonap-clone",
  "version": "0.1.0",
  "private": true,
  "description": "Générateur de posters d'analyse de site : 35 analyses rendues en SVG depuis OpenStreetMap, NASA POWER et Terrarium. Moteur de plan partagé navigateur/serveur, licences signées Ed25519. Clone d'étude d'après un rapport de rétro-ingénierie.",
  "keywords": [
    "urbanisme",
    "analyse-de-site",
    "openstreetmap",
    "overpass",
    "svg",
    "generateur-de-planches",
    "architecture",
    "sig"
  ],
  "license": "MIT",
  "author": "MapToNap-clone contributors",
  "type": "module",
  "main": "server/index.mjs",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "test": "node tools/run-tests.mjs",
    "test:net": "MTN_NET=1 node tools/run-tests.mjs",
    "lint": "node tools/check-syntax.mjs",
    "svg": "node tools/render-svg.mjs",
    "capture": "node tools/capture-sample.mjs",
    "personnaliser": "node tools/personaliser.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CHANGER-MOI/maptonap-clone.git"
  },
  "bugs": {
    "url": "https://github.com/CHANGER-MOI/maptonap-clone/issues"
  },
  "homepage": "https://github.com/CHANGER-MOI/maptonap-clone#readme",
  "dependencies": {},
  "devDependencies": {}
}
