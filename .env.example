# Copiez ce fichier en .env.local pour `vercel dev`, ou renseignez les mêmes
# noms dans Vercel → Project → Settings → Environment Variables.

# Clé de signature des licences (base64 d'un JWK Ed25519).
# Générer :  npm run genere-cle
# Sans elle, l'application fonctionne en essai gratuit et l'activation de code
# répond NO_SIGNING_KEY.
FM_SIGNING_KEY=

# Catalogue de licences, en JSON : { "code": { "plan": "pro", "tier": "pro", "days": 30 } }
# Absent, ce sont les codes de démonstration du dépôt qui s'appliquent.
FM_CODES=

# Port du serveur Node local (sans objet sur Vercel).
PORT=4173

# Accès aux analyses : `open` (défaut) ouvre tout le monde à toutes les
# analyses, sans licence ni quota — la période d'essai. `licence` rétablit le
# découpage 4 gratuites / Pro / Max, le quota par IP et le filigrane.
# Voir docs/ACCES.md.
FM_ACCESS=open
