# Copiez ce fichier en .env.local pour `vercel dev`, ou renseignez les mêmes
# noms dans Vercel → Project → Settings → Environment Variables.

# Clé de signature des licences (base64 d'un JWK Ed25519).
# Générer :  npm run genere-cle
# Sans elle, l'application fonctionne en essai gratuit et l'activation de code
# répond NO_SIGNING_KEY.
FM_SIGNING_KEY=

# Clé publique de l’émetteur des fichiers .utlic (base64 de 32 octets Ed25519).
# Générer le coffre privé local : npm run licence:init. Seule la partie publique
# affichée par le générateur va dans Vercel / cet environnement.
FM_LICENSE_PUB=

# Catalogue de codes historiques, en JSON : { "code": { "plan": "pro", "tier": "pro", "days": 30 } }
# Absent, codes de démonstration uniquement en développement local; aucun en production. Les .utlic ne nécessitent pas FM_CODES.
FM_CODES=

# Port du serveur Node local (sans objet sur Vercel).
PORT=4173

# Accès aux analyses : `open` (défaut) ouvre tout le monde à toutes les
# analyses, sans licence ni quota — la période d'essai. `licence` rétablit le
# découpage 5 gratuites / Pro / Max et le quota. Voir docs/ACCES.md.
FM_ACCESS=open

# Authentification des étudiants : laisser `off` tant que la préproduction
# n'a pas été validée. `required` protège les API et exige la session OTP.
FM_STUDENT_AUTH=off
FM_AUTH_DATABASE_URL=
FM_AUTH_OTP_KEY=
FM_AUTH_DB_SSL=true

# Relais SMTP fourni par l'université ou le prestataire choisi.
# Secrets uniquement dans les variables locales protégées / Vercel, jamais dans Git.
FM_AUTH_SMTP_HOST=
FM_AUTH_SMTP_PORT=587
FM_AUTH_SMTP_SECURE=false
FM_AUTH_SMTP_USER=
FM_AUTH_SMTP_PASSWORD=
FM_AUTH_EMAIL_FROM=
FM_AUTH_EMAIL_NAME=UrbaTrame
