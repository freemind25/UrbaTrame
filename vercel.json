{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "framework": null,
  "rewrites": [
    { "source": "/analysis/2d", "destination": "/api/analysis/2d" },
    { "source": "/api/util", "destination": "/api/util" }
  ],
  "functions": {
    "api/**/*.js": {
            "maxDuration": 60,
      "memory": 512
    }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
